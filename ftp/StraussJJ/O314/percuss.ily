\language "italiano"

timpani_intro = \drummode
{
    \clef bass
    \time 6/8
    \tempo "Andantino"
    
    R2. * 12 |
    timl2.-\f-\>-\trill ~ |
    timl4-\! r8 r4. |
    r4. timh4-\ppp r8 |
    timh4 r8 r4. |
    r timh4 r8 |
    timh4 r8 r4. |
    r timh4 r8 |
    timh4 r8 r4. |
}

triangle_intro = \drummode
{
    \time 6/8
    \tempo "Andantino"
    
    R2. * 20 |
}

drum_intro = \drummode
{
    \time 6/8
    \tempo "Andantino"
}

bass_drum_intro = \drummode
{
    \time 6/8
    \tempo "Andantino"
}