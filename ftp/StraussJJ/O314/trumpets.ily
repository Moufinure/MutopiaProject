\language "italiano"

trumpetI_intro = \relative do'
{
    \transposition fa
    \time 6/8
    \tempo "Andantino"
    
    R2. * 12 |
    mi2.-\f-\> ~ |
    mi4-\! r8 r4. |
    R2. * 6 |
}

trumpetII_intro = \relative do'
{
    \transposition fa
    \time 6/8
    \tempo "Andantino"
    
    R2. * 12 |
    do2.-\f-\> ~ |
    do4-\! r8 r4. |
    R2. * 6 |
}