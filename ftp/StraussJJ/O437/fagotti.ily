    mi |
    fa ~ |
    fa8( mi re4. mi8) |
    fa2. ~ |
    fa |
    mi ~ |
    mi8( re do4. re8) |
    do2. ~ |
    do |
    fa,( ~ |
    fa4 re' la) |
    R2. * 6 |
    \bar "||"
    do,4-\pp(( mi2) |
    re2. |
    do |
    si |
    re |
    mi |
    re |
    do |
    do4( mi2) |
    re2. |
    dod |
    fa4-\p( sol la) |
    la2.-\mf-\> |
    sol |
    la2-\pp fa4-. |
    mi-. r r |
    \bar "||"
    mi'2.-\pp ~ |
    mi |
    fa ~ |
    fa8( mi re4. mi8) |
    fa2. ~ |
    fa |
    mi ~ |
    mi8( re do4. re8) |
    do2.-\ff ~ |
    do |
    fa, ~ |
    fa4( re' la) |
    R2. * 4 |
    \key lab \major
    \mark "Walzer II"
    \repeat volta 2
    {
        mib2.-\mfp ~ |
        mib |
        R2. * 2 |
        sol2.-\mfp ~ |
        sol |
        R2. * 2 |
        r4 fa'-.( fa-.) |
        fa( mib lab,) |
        lab( sol) lab-. |
        sib2 sol8-. lab-. |
        sib4 r mib,-^( |
        sib') r mib,-^( |
        do'2.) ~ |
        do |
        lab ~ |
        lab4 r r |
        R2. * 2 |
        sol2.-\mfp ~ |
        sol |
        R2. * 2 |
        solb2.-\p ~ |
        solb-\>( |
