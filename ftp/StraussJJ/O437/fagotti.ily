    R2. |
    mi,4.-^( sol8 do4) |
    R2. |
    fa,4.-^( la8 do4) |
    R2. * 3 |
    fa,4.-^( la8 do4) |
    r r la-\f |
    re r r |
    do2.-^-\sf |
}

fagottiII = \relative do
{
    \clef bass
