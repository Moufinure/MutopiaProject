    R2. * 3 |
    \bar "||"
    \mark "Walzer I"
    R2. * 10 |
    dod4-\p la dod |
    re( mi fa) |
    fa,2-\mf r4 |
    R2. |
    re'2-\pp sol,4-. |
    do-. r r |
