        lab r r |
        mib' r r |
        mib2 mib8-.-\< fa-. |
        sol4-\f r r |
        sol r r |
        lab2. |
        lab2 r4 |
        fa2. ~ |
        fa4 r r |
        R2. * 2 |
        mib2.-\mfp ~ |
        mib |
        R2. * 2 |
