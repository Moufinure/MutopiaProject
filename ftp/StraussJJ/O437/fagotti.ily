    do4-. do-. do-. r |
    R1 * 9 |
    fad2-\p( sol4) r |
    R1 * 8 |
    la4-\p r la r |
    \repeat unfold 3 { la r la r | }
    do,2-\p( mi4. si8 |
    re1) |
    do |
    sol' |
    do,2-\cresc( fa4. mi8 |
    re1) |
    do2( sol'4. fa8) |
    mi2( re) |
