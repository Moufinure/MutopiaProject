    sol r8 sol sol4 r8 la |
    la4-. la-. sol-. r |
    r do r si |
    do-. re8-. mi-. re4-. r |
    r sol, r8 fa'-. re-. si-. |
    r4 sol r8 fa'-. re-. si-. |
    do1-\p ~ |
    do2 r |
    si,4 sol' si, sol' |
    do, sol' do, sol' |
    r si-\p sold si |
    r sold mi sold |
    R1 * 8 |
    re'1-\f ~ |
    re ~ |
    re ~ |
    re |
    R1 * 2 |
    la1 ~ |
    la ~ |
    la4 r r2 |
    R1 |
    sol1-\p ~ |
    sol ~ |
    sol2 r |
    R1 |
    \bar "||"
    \time 3/4
    \tempo "Tempo di valse"
    R2. * 3 |
    \bar "||"
    \mark "Walzer I"
    do,4-\p( mi4. sol,8 |
    re'2.) |
    do4( sol do |
    si2.) |
    re4( fa4. sol,8 |
    mi'2.) |
    re4( sol, re' |
    do2.) |
    do4( mi4. sol,8 |
    re'2.) |
    dod4-\p( la' sol) |
    fa( sol la) |
