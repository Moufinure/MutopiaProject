    do r do |
    si si si |
    do2.-\f |
    \bar "||"
    si2.-^-\markup { \italic "marcato" } |
    si4 do sol |
    la2. |
    do |
    si |
    si4 do sol |
    la2. |
    re |
    do |
    si4 do la |
    sol2. |
    si |
    la |
    sol4 la fa |
    mi2. |
    do'-\ff-\markup { \italic "marcato" } |
    si-^ |
    si4 do sol |
    la2. |
    do |
    si |
    si4 do la |
    mi'2. ~ |
