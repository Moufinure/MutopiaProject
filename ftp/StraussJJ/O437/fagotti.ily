    re2. |
    do4 si la |
    la2 sol4 |
    mi sol do |
    sol2.-^ |
    sol-^ |
    do,4-^ mi sol |
    do, r r |
    \bar "||"
    \key fa \major
    \mark "Walzer IV"
    do4-\f re2 |
    mi4 fa fad |
    sol la sib |
    R2. |
    \mark \markup { \musicglyph "scripts.segno" }
    \repeat volta 2
    {
        R2. * 2 |
        fa4.-\f( la8 do4) |
        R2. |
        mi,4.-^( sol8 do4) |
        R2. |
        fa,4.-^( la8 do4) |
        R2. * 3 |
        fa,4.-^( la8 do4) |
        R2. |
        do4-\f r si |
        do r si |
    }
    \alternative
    {
        {
            do4 r r |
            R2. |
        }
        {
            do4 r r |
            R2. |
        }
    }
    r4 r do-\mf( |
    sib2 la4) |
    r r do ~ |
    do2. |
    la4( do fa) |
    la,2 la4 |
    sib2. ~ |
    sib8 r r4 r |
    la4( sib2) ~ |
    sib2. |
    fad4( sol2) ~ |
    sol2. |
    sib4( do2 |
    mi2.) |
    fa4 r r |
    R2. |
    r4 r do-\mf( |
    sib2 la4) |
    r r do ~ |
    do2. |
    la4( do fa) |
    mib r r |
    R2. * 2 |
    mi,2.-^-\f |
    fa-^ |
    sol-^ |
    R2. |
    \bar "||"
    R2. * 2 |
