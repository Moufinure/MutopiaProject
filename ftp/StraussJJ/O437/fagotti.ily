        R2. |
        r4 fa-\< fa |
        fa fa fa |
        fa-\f r r |
        sib,2.-\sf-^ |
        fad'8-\p fad sol4 sol |
        lab r lab |
        lab8 lab sol4 lab |
        mib r mib |
        sib'8 sib sib4 sib |
        lab r lab |
        fa-\f r r |
        sib,2.-\sf-^ |
        fad'8-\p fad sol4 sol |
