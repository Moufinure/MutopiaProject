fagottiI = \relative do'
{
    \clef bass
    \time 2/2
    \tempo "Langsames Marschtempo"
    
    \mark "Introduction"
    R1 * 2 |
    sol4-\pp r8 sol sol4 r8 sol |
    sol4-. sol-. sol-. r |
    sol r8 sol sol4 r8 sol |
    sol4-. sol-. sol-. r |
    R1 * 4 |
    do4-\p r8 do mi4 r8 si |
    re4-. re-. do-. r |
    R1 * 2 |
    do2( si4) r |
    R1 |
    do2-\p( si4) r |
    R1 * 5 |
    sib2-\p( la) |
    sib( la) |
    do4-\p r do r |
    re r do r |
