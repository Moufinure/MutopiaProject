    mi4-\mf sol do |
    mi2( do8) r |
    do2-^( si8) r |
    si2 r4 |
    fa'2-^( si,8) r |
    si4 r r |
    fa'2-^( si,8) r |
    si4 si16( do) r8 re16( mi) r8 |
    fa2-^( si,8) r |
    si4 r r |
    R2. |
    do4 la16( si) r8 do16( re) r8 |
    R2. |
    r4 la-\mf( si8 sol |
    do4) r r |
    r la( sol8 fa) |
    mi4-\mf sol do |
    mi2( do4) |
    do2-^( si8) r |
    r4 sol'16( fad) r8 mi16( re) r8 |
    la2.-^-\f |
    re,8-. mi-. fad-. sol-. la-. si-. |
    do2.-^ ~ |
    do8-. si-. la-. sol-. fad-. mi-. |
