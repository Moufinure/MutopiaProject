\language "italiano"

corniI = \relative do'
{
  \time 6/8
  \tempo "Allegro"
  \transposition re

  R2. * 5 |
  R2.-\fermata |
  re'2. |
  re4.-\dim re |
  re2. ~ |
  re4-\! r8 r4. |
  R2. * 4 |
  r4.-\fermata \bar "||" r |
  R2. * 17 |
  r4. sol ~ |
  sol fa |
  mib8 r r r4. |
  R2. |
  r4. r4 sol,8 |
  sol4.-\p ~ sol8 r r |
  \repeat volta 2
  {
    re'4-\f r8 r4. |
    R2. |
    re4-\f r8 r4. |
    R2. |
    re4-\f r8 sol,4. ~ |
    sol8 r r r4. |
    r do4.-\dim ~ |
    do sol |
    R2. * 6 |
    r4. r4 sol8-\p |
  }
  \alternative
  {
    { sol4.( do8) r r | }
    { do r r r4. | }
  }
  R2. * 13 |
  sol8-\pp r r sol r r |
  sol r r sol r r |
  do4. ~ do8 r do
  do4. ~ do8 r do |
  sol4. ~ sol8 r sol |
  sol4. ~ sol8 r r |
  R2. * 4 |
  re'4. ~ re8 r re |
  mi4. ~ mi8 r mi |
  re r re re r re |
  re4. ~ re8 r r |
  re4. ~ re8 r re |
  mi4. ~ mi8 r mi |
  re r re re r re |
  sol, r r r4. |
  R2. * 14 |
  r4. r4 sol8-\p |
  sol4.( do8) r r |
  \repeat volta 2
  {
    mi4-\ff r8 do4 r8 |
    mi4 r8 re4 r8 |
    do4 r8 mi-. mi-. mi-. |
    fa r mi re r sol, |
    mi'4 r8 do4-\p r8 |
    mi4 r8 re4 r8 |
    do4 r8 do-. do-. do-. |
    re r re do r r |
  }
  \repeat volta 2
  {
    do4-\p r8 \repeat unfold 13 { do4 r8 } |
    sol4 r8 re' r sol,-\ff |
    mi'4-\ff r8 do4-\p r8 |
    mi4 r8 re4 r8 |
    do4 r8 mi-. mi-. mi-. |
    fa r mi re r sol,-\ff |
    mi'4 r8 do4-\p r8 |
    mi4 r8 re4 r8 |
  }
  \alternative
  {
    {
      do4 r8 r4. |
      R2. |
    }
    {
      do8 r r r4. |
    }
  }
  re8-\f r r r4. |
  re8 r r r4. |
  sol8 r r r4.-\fermata |
  \bar "||"
  R2. |
  r4. sol,8-\pp r r |
  R2. |
  r4. sol8 r r |
  r4. sol8 r r |
  r4. sol8 r r |
  r4. sol8-\< r r |
  r4. sol8 r r |
  sol-\! r r r4. |
  R2. * 15 |
  sol8-\p r r r4. |
  sol8 r r r4. |
  \clef bass
  R2. * 3 |
  \clef treble
  sol8-\pp r r sol r r |
  \clef bass
  R2. * 3 |
  \clef treble
  sol8 r r sol r r |
  do r r r4. |
  r sol8-\pp r r |
  do r r r4. |
  R2. * 9 |
  \bar "|."
}

corniII = \relative do'
{
  \time 6/8
  \tempo "Allegro"
  \transposition re

  R2. * 5 |
  R2.-\fermata |
  re'2. |
  re4.-\dim re |
  re2. ~ |
  re4-\! r8 r4. |
  R2. * 4 |
  r4.-\fermata \bar "||" r |
  R2. * 8 |
  r4. sol,,8-\p r r |
  R2. |
  r4. sol8-\p r r |
  R2. * 5 |
  r4. sol8-\p r r |
  R2. |
  r4. sol8 r r |
  do r r r4. |
  R2. |
  r4. r4 sol8 |
  sol4.( do8\p) r r |
  \repeat volta 2
  {
    sol'4-\f r8 r4. |
    R2. |
    sol4-\f r8 r4. |
    R2. |
    sol4-\f r8 sol,4. ~ |
    sol8 r r r4. |
    R2. * 3 |
    r4. sol8-\p r r |
    R2. |
    r4. sol8 r r |
    R2. * 2 |
    r4. r4 sol8-\p |
  }
  \alternative
  {
    { sol4.( do8) r r | }
    { do r r r4. | }
  }
  R2. * 13 |
  sol8-\pp r r sol r r |
  sol r r sol r r
  do4. ~ do8 r do
  do4. ~ do8 r do |
  sol4. ~ sol8 r sol |
  sol4. ~ sol8 r r |
  R2. * 4 |
  sol'4.-\p ~ sol8 r sol |
  do4. ~ do8 r do |
  re r re re r re |
  sol,4. ~ sol8 r r |
  sol4. ~ sol8 r sol |
  do4. ~ do8 r do |
  re r re re r re |
  sol, r r r4. |
  R2. |
  r4. sol,8-\p r r |
  R2. |
  r4. sol8 r r |
  R2. * 5 |
  r4. sol8-\p r r |
  R2. |
  r4. sol8 r r |
  R2. * 2 |
  r4. r4 sol8-\p |
  sol4.( do8) r r |
  \repeat volta 2
  {
    do'4-\ff r8 sol4-\p r8 |
    mi4 r8 mi4 r8 |
    mi4 r8 do'-. do-. do-. |
    do r do sol r sol-\ff |
    do4 r8 sol4-\p r8 |
    mi4 r8 mi4 r8 |
    mi4 r8 mi-. mi-. mi-. |
    mi r mi mi r r |
  }
  \repeat volta 2
  {
    do4-\p r8 \repeat unfold 13 { do4 r8 } |
    sol4 r8 sol' r sol-\ff |
    do4-\ff r8 sol4-\p r8 |
    mi4 r8 mi4 r8 |
    mi4 r8 do'-. do-. do-. |
    do r do sol r sol-\ff |
    do4 r8 sol4-\p r8 |
    mi4 r8 mi4 r8 |
  }
  \alternative
  {
    {
      mi4 r8 r4. |
      R2. |
    }
    {
      mi8 r r r4. |
    }
  }
  re'8-\f r r r4. |
  sol,8 r r r4. |
  sol'8 r r r4.-\fermata |
  \bar "||"
  R2. |
  r4. sol,,8-\pp r r |
  R2. |
  r4. sol8 r r |
  r4. sol8 r r |
  r4. sol8 r r |
  r4. sol8-\< r r |
  r4. sol8 r r |
  sol-\! r r r4. |
  R2. * 2 |
  r4. sol8-\p r r |
  R2. |
  r4. sol8-\p r r |
  R2. * 5 |
  r4. sol8-\p r r |
  R2. |
  r4. sol8-\p r r |
  R2. * 2 |
  sol8-\p r r r4. |
  sol8 r r r4. |
  \clef bass
  do,,2.-\p ~ |
  do ~ |
  do4. ~ do8 r r |
  \clef treble
  sol''8-\pp r r sol r r |
  \clef bass
  do,,2. ~ |
  do ~ |
  do4. ~ do8 r r |
  \clef treble
  sol''8 r r sol r r |
  do r r r4. |
  r sol8-\pp r r |
  do r r r4. |
  R2. * 9 |
  \bar "|."
}

