\language "italiano"

viola = \relative do'
{
  \clef alto
  \key sol \major
  \tempo "Lent" 4 = 54

  sol8-\pp^\markup "pizz." si sol si sol si sol si |
  fad si fad si sol si sol si |
  do mi do mi do mi do mi |
  do re do re si re si re |
  si do si do la do la do |
  fad, si fad si la do-\pp^\markup "arco"[( si fad]) |
}