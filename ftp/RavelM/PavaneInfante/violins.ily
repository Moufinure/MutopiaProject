\language "italiano"

violinI = \relative do''
{
  \key sol \major
  \tempo "Lent" 4 = 54

  R1 * 6 |
}

violinII = \relative do'
{
  \key sol \major
  \tempo "Lent" 4 = 54

  si8-\p^\markup "pizz." re si re si mi si mi |
  si re si re si mi si mi |
  mi sol mi sol mi sol mi sol |
  re fad re fad re fad re fad |
  do mi do mi do mi do mi |
  si re si re do mi-\pp^\markup "arco"[( re do]) |
}