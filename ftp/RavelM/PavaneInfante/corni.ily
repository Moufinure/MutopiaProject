\language "italiano"

corniI = \relative do''
{
  \tempo "Lent" 4 = 54
  \transposition sol

  do2-\pp( ~ do8 re si la |
  sol4 la8 si si la la4) |
  mi'2( ~ mi8 fad re do |
  si4 do8 re re mi do si |
  la4 si8 do ~ do re si la |
  sol4 la) r2 |
}

corniII = \relative do'
{
  \tempo "Lent" 4 = 54
  \transposition sol

  mi1-\pp( |
  si2 do) |
  do1( |
  si'2 mi, |
  la1 |
  si2) r |
}