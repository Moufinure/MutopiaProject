\language "italiano"

fagottoI = \relative do
{
  \clef bass
  \key sol \major
  \tempo "Lent" 4 = 54

  re2-\pp( mi |
  si re) |
  do'1( ~ |
  do2 fad, |
  si do |
  re do4) r |
}

fagottoII = \relative do
{
  \clef bass
  \key sol \major
  \tempo "Lent" 4 = 54

  sol2-\pp( do, |
  re mi) |
  la1( |
  re2 sol, |
  do fad, |
  si fad4) r |
}