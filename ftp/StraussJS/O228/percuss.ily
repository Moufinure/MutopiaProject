\language "italiano"

tamburo = \drummode
{
  sn8-\ff sn sn r sn sn sn r |
  sn4 sn sn2:32 |
  sn4 r r sn |
  sn r r sn:32-\pp
  sn4 sn:32 sn sn:32 |
  sn sn:32 sn sn:32 |
}

casa_piatti = \drummode
{
  bd4-\ff r bd r |
  bd bd bd r |
  bd r r bd |
  bd r r2 |
  \bar "||"
  bd4-\pp r bd r |
  bd r r2 |
}
