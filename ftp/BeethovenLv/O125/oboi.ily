    \time 4/4
    \key re \major
    \tempo "Allegro assai"
    la4-\markup { \italic "dolce" } r r2 |
    R1 |
    dod4 dod( re mi) |
    mi( re) sol,( la) |
    \bar "||"
    \time 3/4
    \tempo "Tempo I."
    la-\f dod-. r |
