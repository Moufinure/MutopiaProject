    fad fad( la re) |
    re4.( dod8) dod2 |
    re-\f( mi4 fad) |
    fad( mi) re-.( la-.) |
    fad-.( fad-. la-. re-.) |
    la4.( fad8) fad2 |
    dod'( re4) ~ re |
    dod( re8 mi re4) re |
    dod( re8 mi) dod4 ~ dod |
    si-! sold-! la-! re ~ |
    re re-.( mi-. fad-.) |
    fad( mi) re-.( la-.) |
    fad-.( fad-. la-. re-.) |
    la4.( fad8) fad-! fad'( mi re) |
    dod2-\sf re4( fad,) |
    dod'( re8 mi re4) re |
    dod( re8 mi) dod4 dod |
    si-! sold-! la-! re ~ |
    re re-.( mi-. fad-.) |
    
}