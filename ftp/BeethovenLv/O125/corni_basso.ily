\include "italiano.ly"
\include "common.ily"

corniBassI_mvtI = \relative do''
{
    \clef treble
    \time 2/4
    \tempo "Allegro ma non troppo, un poco maestoso" 4 = 88
    
    R2 * 14 |
    r8 mi4.-\cresc ~ |
    mi4 ~ mi8.. mi32-\ff |
    mi4 ~ mi8.. mi32 |
    mi8.. mi32 mi 8. mi32 mi |
    mi4 ~ mi16 r r8 |
    R2 |
    mi8.-\sf r16 r4 |
    mi8.-\sf r16 r4 |
    mi8.-\sf r16 mi8.-\sf r16 |
    r4 do-\ff ~ |
    do2 |
    do8 do-.( do-. do-.) |
    do-\sf r r4 |
    R2 * 3 |
    r4 do-\sf ~ |
    do sol'-\sf ~ |
    sol sol8 r |
    R2 * 14 |
    mi2-\cresc ~ |
    mi8 do4. ~ |
    \autoBeamOff
    do4 do8.. do32-\ff |
    \autoBeamOn
    sol'4 ~ sol8.. mi32 |
    do8.. sol32 mi'8. sol32( mi) |
    do4 ~ do16 mi-. re-. do-. |
    sol'8 fa re sol |
    mi r r4 |
    r16 do-. do-. do-. do8 r |
    do-\sf r r4 |
    r16 do-. do-. do-. do8 r |
    sol'-\sf r r4 |
    r16 mi-. mi-. mi-. mi8 r |
    r16 mi mi mi mi8-\sf r |
    r16 mi mi mi mi8-\sf r |
    R2 * 6 |
    r4 r8 mi |
    do do do-. do |
    do8.-\sf r16 do8.-\sf r16 |
    re8.-\sf r16 re8.-\sf r16 |
    re8.-\> r16 sol,8. r16 |
    re'2-\pdolce ~ |
    re |
    mi4.( fa16 sol) |
    sol8( fa16 mi) mi8( re16 do) |
    re2 ~ |
    re4 sol, ~ |
    sol4. sol8 ~ |
    sol4. sol8 ~ |
    sol4. sol8 ~ |
    sol4. sol8 |
    sol  sol4.-\< ~ |
    sol8 sol4. ~ |
    sol8 sol4.-\> ~ |
    sol8 sol4. ~ |
    sol8-\p r r4 |
    R2 * 3 |
    do2-\cresc ~ |
    do16 do ~ do do ~ do do ~ do do ~ |
    do-\f do ~ do do ~ do do ~ do do |
    mi8-. r re-. r |
    do2-\p ~ |
    do16 do ~ do do ~ do do ~ do do ~ |
    do8 r r4 |
    R2 |
    sol16 sol ~ sol sol ~ sol sol ~ sol sol ~ |
    sol sol ~ sol sol ~ sol sol ~ sol sol |
    do8-\ff-. do16.-. do32-. do8 r |
    do-. do16.-. do32-. do8 r |
    R2 * 2 |
    do8-\ff-. do16.-. do32-. do8 r |
    do-. do16.-. do32-. do8 r |
    R2 * 8 |
    r4 r8 sol'-\semprepp |
    r do, r sol' |
    r do, r do |
    r do r fa |
    re2 ~ |
    re
}

corniBassII_mvtI = \relative do'
{
    \clef treble
    \time 2/4
    \tempo "Allegro ma non troppo, un poco maestoso" 4 = 88
    
    R2 * 14 |
    r8 sol'4.-\cresc ~ |
    sol4 ~ sol8.. sol32-\ff |
    sol4 ~ sol8.. sol32 |
    sol8.. sol32 sol 8. sol32 sol |
    mi4 ~ mi16 r r8 |
    R2 |
    mi8.-\sf r16 r4 |
    mi8.-\sf r16 r4 |
    mi8.-\sf r16 mi8.-\sf r16 |
    r4 do'-\ff ~ |
    do2 ~ |
    do8 do-.( do-. do-.) |
    do-\sf r r4 |
    R2 * 3 |
    r4 do,-\sf ~ |
    do sol'-\sf ~ |
    sol sol8 r |
    R2 * 14 |
    mi2-\cresc ~ |
    mi8 do4. ~ |
    \autoBeamOff
    do4 do8.. do'32-\ff |
    \autoBeamOn
    sol4 ~ sol8.. mi32 |
    do8.. sol32 mi'8. sol32( mi) |
    do4 ~ do16 mi'-. re-. do-. |
    sol'8 fa re sol, |
    mi r r4 |
    r16 do-. do-. do-. do8 r |
    do-\sf r r4 |
    r16 do-. do-. do-. do8 r |
    sol'-\sf r r4 |
    r16 mi-. mi-. mi-. mi8 r |
    r16 mi mi mi mi8-\sf r |
    r16 mi mi mi mi8-\sf r |
    R2 * 6 |
    r4 r8 mi |
    do do do-. do |
    do8.-\sf r16 do8.-\sf r16 |
    re'8.-\sf r16 re8.-\sf r16 |
    sol,8.-\> r16 sol,8. r16 |
    sol'2-\pdolce ~ |
    sol |
    do4.( re16 mi) |
    mi8( re16 do) do8( sol16 mi) |
    sol2 ~ |
    sol4 sol, ~ |
    \bar "||"
    sol4. sol8 ~ |
    sol4. sol8 ~ |
    sol4. sol8 ~ |
    sol4. sol8 ~ |
    sol  sol4.-\< ~ |
    sol8 sol4. ~ |
    sol8 sol4.-\> ~ |
    sol8 sol4. ~ |
    sol8-\p r r4 |
    R2 * 3 |
    do2-\cresc ~ |
    do16 do ~ do do ~ do do ~  do do ~ |
    do-\f do ~ do do ~ do do ~ do do |
    do'8-. r sol -. r |
    do,2-\p ~ |
    do16 do ~ do do ~ do do ~  do do ~ |
    do8 r r4 |
    R2 |
    sol16 sol ~ sol sol ~ sol sol ~ sol sol ~ |
    sol sol ~ sol sol ~ sol sol ~ sol sol |
    do8-\ff-. do16.-. do32-. do8 r |
    do-. do16.-. do32-. do8 r |
    R2 * 2 |
    do8-\ff-. do16.-. do32-. do8 r |
    do8-. do16.-. do32-. do8 r |
    R2 * 8 |
    r4 r8 sol'-\semprepp |
    r do, r sol' |
    r do, r do |
    r do r fa' |
    r8 sol,4.-\semprepp ~ |
    sol2 |
}