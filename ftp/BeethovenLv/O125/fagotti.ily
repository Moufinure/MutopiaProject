    si( la sol fad) ~ |
    fad( la re dod) |
    r \clef tenor re2( mi8 fad) |
    re4.( mi8 fad4 si,) ~ |
    si( la8 sol fad mi' re dod |
    si4 dod re) r |
    R1 |
    \clef tenor
    dod2.-\p( si8 dod) |
    re2( mi) |
    re4-\cresc( mi ~ mi re) ~ |
    re8-\p la re4 ~ re8 mi fad4 ~ |
    fad8 re mi4( fad si,) ~ |
    si la8( sol fad mi' re dod |
    si4 dod re) r |
    R1 |
    la2( ~ la8 fad sol la) |
    si2( dod |
    re4-\cresc mi2 re4) ~ |
    re8-\p la re4. mi8 fad4 ~ |
    fad8 re mi4( fad8 la, si dod) |
    re( si la sol fad mi re dod) |
    si4 si'8( dod) re-! la( si dod) |
    re4 r r2 |
    R1 |
    re2( mi4 fad) |
    fad4.( mi8 mi2) |
    R1 * 2 |
    re2( mi4 fad) |
    mi4.( re8) re2 |
    R1 * 2 |
    mi4( fad8 sol fad4 mi) |
    re-\cresc( mi la, fad'-\!) |
    R1 * 2 |
    re2( mi4 fad) |
    mi4.( re8) re2 |
    R1 * 2 |
    mi4( fad8 sol fad4 mi) |
    re( mi la, fad') |
    R1 * 2 |
