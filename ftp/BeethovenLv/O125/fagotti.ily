    \bar "||"
    \time 3/4
    \tempo "Allegro"
    re4 r r |
    R2. * 9 |
    r4 r sold-\p( |
    si2.) |
    \bar "||"
    \time 4/4
    \key re \major
    \tempo "Allegro assai"
