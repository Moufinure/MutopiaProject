\include "italiano.ly"
\include "common.ily"

fagottiI_mvtI = \relative do
{
    \clef bass
    \key re \minor
    \time 2/4
    \tempo "Allegro ma non troppo, un poco maestoso" 4 = 88
    
    R2 * 13 |
    la2-\cresc ~ |
    la8( re,4.) ~ |
    re4 ~ re8.. re''32-\ff
    la4 ~ la8.. fa32 |
    re8.. la32 fa8. la32( fa) |
    re4 ~ re16 fa'-. mi-. re-. |
    la'8-. sol-. mi-. la-. |
    re8.-\sf r16 la8.-\sf r16 |
    re,8.-\sf r16 r4 |
    sol8.-\sf r16 la8.-\sf r16 |
    si2-\ff ~ |
    si4. la8-.( |
    sol-. fa'-. mib-. re-.) |
    dod-\sf r r4 |
    sol-\p( mi8.. fa32) |
    fa8 r r4 |
    la-\p( fa8.. sol32) |
    sol8-\f r sol4-\sf ~ |
    sol sold-\sf ~ |
    sold la-\sf ~ |
    la la,8-\sf r |
    re4.\dim r8-\! |
    R2 * 12 |
    re,2-\cresc ~ |
    re8( sib4.) ~ |
    \autoBeamOff
    sib4 ~ sib8.. sib''32-\ff |
    \autoBeamOn
    fa4 ~ fa8.. re32 |
    sib8.. fa32 re8. fa'32( re) |
    sib4 ~ sib16 re-. do-. sib-. |
    fa'8-. mib-. do-. fa-. |
    re r r4 |
    r16 fa-. mib-. re-. sib'8 r |
    mi,-\sf r r4 |
    r16 sol-. fa-. mi-. dod'8 r |
    fa,-\sf r r4 |
    r16 la-. sol-. fa-. re'8 r |
    r16 la sol fad re'-\sf sib la sol |
    re'-\sf sib, la sol sold-\sf si' si si |
    la2-\sf ~ |
    la ~ |
    la8-\markup { \italic "ben marcato" } la-. la-. la-. |
    la8.-\sf r16 la8.-\sf r16 |
    la2-\sf |
    sol8-. fa-. mi-. re-. |
    dod re-. mi-. fa-. |
    sol8. r16 fa8. r16 |
    sol'8.-\sf r16 fa8.-\sf r16 |
    mi8.-\sf r16 solb,8.-\sf r16 |
    do8.-\> r16 do8. r16 |
    mib4.-\pdolce( fa16 sol) |
    sol8( fa16 mib) mib8( re16 do) |
    do8( sib) r4 |
    R2 |
    mib4.( fa16 sol) |
    sol8( fa16 mib) mib8( re16 do) |
    \bar "||"
    \key sib \major
    re4. sol8-> |
    fa4 r |
    la,4. mib'8-> |
    do4 r |
    r8 re,4-\<( sol16 fa) |
    r8 fa4( do'16 sib) |
    r8 la4-\>( re16 do) |
    r8 do4( sol'16 solb) |
    fa8-\p( mi fa4) ~ |
    fa8 fa fa fa |
    r8 dod( re4) ~ |
    re8 re re re | 
    re r r4 |
    r r16 re-\cresc( mib) fa( |
    sol-\f) fa( mib) re( do) sib( la) sol( |
    fa) fa' re sib fa la do fa |
    sol,2-\p( |
    fa'16) mib( re) do( sib) lab( sol) fa( |
    mib2-\cresc)( |
    re'16) do( si) lab( sol) fa( mib) re( |
    do) fa,( sol) la( sib) do( re) mib( |
    fa) sol( la) sib( do) re( mib) fa |
    re,8-\ff re16.-. re32-. re8 r |
    mib,-. re16.-. re32-. mib8 r |
    mib''2-\pdolce( |
    fa) |
    re,,8-\ff-. re16.-. re32-. re8 r |
}

fagottiII_mvtI = \relative do
{
    \clef bass
    \key re \minor
    \time 2/4
    \tempo "Allegro ma non troppo, un poco maestoso" 4 = 88
    
    R2 * 13 |
    la2-\cresc ~ |
    la8( re,4.) ~ |
    re4 ~ re8.. re''32-\ff |
    la4 ~ la8.. fa32 |
    re8.. la32 fa8. la32( fa) |
    re4 ~ re16 fa'-. mi-. re-. |
    la'8-. sol-. mi-. la-. |
    re8.-\sf r16 la8.-\sf r16 |
    re,8.-\sf r16 r4 |
    sol8.-\sf r16 fad8.-\sf r16 |
    sol2-\ff ~ |
    sol4. la8-.( |
    sol-. fa-. mib-. re'-.) |
    dod8-\sf r r4 |
    mi,4-\p( dod8.. re32) |
    re8 r r4 |
    fa-\p( re8.. mi32) |
    mi8-\f r sol,4-\sf ~ |
    sol sold-\sf ~ |
    sold la-\sf ~ |
    la la8-\sf r |
    re4.-\dim r8-\! |
    R2 * 12 |
    re,2-\cresc ~ |
    re8( sib4.) ~ |
    \autoBeamOff
    sib4 ~ sib8.. sib''32-\ff |
    \autoBeamOn
    fa4 ~ fa8.. re32 |
    sib8.. fa32 re8. fa32( re) |
    sib4 ~ sib16 re-. do-. sib-. |
    fa'8-. mib-. do-. fa-. |
    re r r4 |
    r16 fa-. mib-. re-. sib'8 r |
    mi,-\sf r r4 |
    r16 sol-. fa-. mi-. dod'8 r |
    fa,-\sf r r4 |
    r16 la-. sol-. fa-. re'8 r |
    r16 la sol fad re'-\sf sib la sol |
    re'-\sf sib la sol sold-\sf sold' sold sold |
    la,2-\sf ~ |
    la ~ |
    la8-\markup { \italic "ben marcato" } la-. la-. la-. |
    la8.-\sf r16 la8.-\sf r16 |
    la2-\sf |
    sol8-. fa-. mi-. re-. |
    dod'-. re,-. mi-. fa-. |
    sol8. r16 fa8. r16 |
    sol'8.-\sf r16 fa8.-\sf r16 |
    mi8.-\sf r16 solb8.-\sf r16 |
    la8.-\> r16 la8. r16 |
    do4.-\pdolce( re16 mib) |
    mib8( re16 do) do8( sib16 la) |
    fa4 r |
    R2 |
    do'4.( re16 mib) |
    mib8( re16 do) do8( fa,) |
    \bar "||"
    \key sib \major
    fa4 r |
    R2 * 7 |
    re'2-\p ~ |
    re8( la) la la |
    sib2 ~ |
    sib8( do) fad, fad |
    sol r r4 |
    r r16 sib-\cresc sib re( |
    mib-\f) re( do) sib( la) sol( fa) mib( |
    fa,) fa' re sib fa la do fa |
    sol,2-\p( |
    fa'16) mib( re) do( sib) lab( sol) fa( |
    mib2-\cresc)( |
    re'16) do( si) lab( sol) fa( mib) re( |
    do) fa( sol) la( sib) do( re) mib( |
    fa) sol( la) sib( do) re( mib) fa |
    re,,8-\ff re16.-. re32-. re8 r |
    mib-. re16.-. re32-. mib8 r |
    mib'2-\pdolce( |
    fa) |
    re,8-\ff re16.-. re32-. re8 r |
}

fagottoI_mvtIV = \relative do,
{
    \clef bass
    \key re \minor
    \time 3/4
    \tempo "Presto" 2. = 96
    
    \partial 4 fa4-\ff ~ |
    fa2. ~ |
    fa ~ |
    fa8 fa'' fa la, la re |
    re fa, fa la la re, |
    re re re do do si |
    si sib sib sib sib sib' |
    sib4-. la-. r |
    R2. * 9 |
    r4 r fad,-\ff ~ |
    fad4. la'8-. la-. do-. |
    do fad, fad la la do, |
    do mib' mib la, la do |
    do fad, fad la la fad, |
    fad do'' do sib sib la |
    la sol sol fad fad fad |
    fad4 r r8 fa |
    fa4 r r |
    R2. |
}

