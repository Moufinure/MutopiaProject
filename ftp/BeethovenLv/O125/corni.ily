\include "italiano.ly"

corniI_mvtI = \relative do''
{
    \clef treble
    \time 2/4
    \tempo "Allegro ma non troppo, un poco maestoso" 4 = 88
    
    re2-\pp ~ |
    \repeat unfold 9 { re ~ | }
    re-\cresc ~ |
    re ~ |
    re ~ |
    re4. sol8 ~ |
    sol2 ~ |
    sol4 ~ sol8.. do32-\ff |
    sol4 ~ sol8.. mib32 |
    do8.. sol32 mib'8. sol32( mib) |
    do4 ~ do16 mib-. re-. do-. |
    sol'8-. fa-. re-. sol-. |
    do,8.-\sf r16 re8.-\sf r16 |
    do8.-\sf r16 r4 |
    do8.-\sf r16 do8.-\sf r16 |
    fa2-\ff ~ |
    fa ~ |
    fa8 fa-.( fa-. fa-.) |
    fa-\sf r r4 |
    sol,2-\p |
    sol8 r r4 |
    sol2-\p |
    fa'8-\f r re4-\sf ~ |
    re do-\sf ~ |
    do mib8-\sf r |
    sol2-\f |
    sol,-\dim ~ |
    sol-\pp ~ |
    \repeat unfold 8 sol ~ |
    sol-\cresc ~ |
    \repeat unfold 2 sol ~ |
    sol4. do8 ~ |
    do2 ~ |
    \autoBeamOff
    do4 ~ do8.. mib32-\ff |
    \autoBeamOn
    mib4 ~ mib8.. do32 |
    do8 r r4 |
    R2 |
    r4 r8 mib |
    do r r4 |
    R2 * 2 |
    r16 fa-. mib-. re-. re8 r |
    do-\sf r r4 |
    r16 sol'-. fa-. mib-. do8 r |
    r16 sol' fa mi do-\sf fa fa fa |
    fa-\sf fa fa fa mib-\sf do do do |
    sol2-\sf |
    sol'-\sf |
    fa8-.-\markup { \italic "ben marcato" } mib-. re-. do-. |
    re8.-\sf r16 mib8.-\sf r16 |
    re8.-\sf r16 r4 |
    sol,2-\sf |
    sol8 sol sol do |
    R2 |
    fa8.-\sf r16 mib8.-\sf r16 |
    re8.-\sf r16 re8.-\sf r16 |
    sib8.-\> r16 sib8. r16-\! |
    R2 * 6 |
    \bar "||"
    r4 mib8-\p r |
    r4 mib8 r |
    r4 mib8 r |
    r4 mib8 r |
    r8 mib4-\< mib8 |
    r mib4 mib8 |
    r mib4-\> mib8 |
    r mib4 mib8 |
    mib-\p r r4 |
    R2 * 5 |
    r4 fa16-\f fa ~ fa fa( |
    mib8) r mib-. r |
    R2 * 2 |
    fa2-\p-\cresc ~ |
    fa16 fa ~ fa fa ~ fa fa ~ fa mib ~ |
    mib mib ~ mib mib ~ mib mib ~ mib mib ~ |
    mib mib ~ mib mib ~ mib mib ~ mib mib |
    mib8-\ff re16.-. re32-. mib8 r |
    fa8-. mi16.-. mi32-. fa8 r |
    R2 * 2 |
    mib8-. re16.-. re32-. mib8 r |
    mi8-. mib16.-. mib32-. mi8 r |
    R2 * 12 |
    r4 mib-\pp ~ |
    mib2 |
}

corniII_mvtI = \relative do''
{
    \clef treble
    \time 2/4
    \tempo "Allegro ma non troppo, un poco maestoso" 4 = 88
    
    sol2-\pp ~ |
    \repeat unfold 9 { sol ~ | }
    sol-\cresc ~ |
    sol ~ |
    sol ~ |
    sol4. sol,8 ~ |
    sol2 ~ |
    sol4 ~ sol8.. do'32-\ff |
    sol4 ~ sol8.. mib32 |
    do8.. sol32 mib'8. sol32( mib) |
    do4 ~ do16 mib'-. re-. do-. |
    sol'8-. fa-. re-. sol-. |
    do,,8.-\sf r16 sol'8.-\sf r16 |
    do,8.-\sf r16 r4 |
    do8.-\sf r16 do8.-\sf r16 |
    fa'2-\ff ~ |
    fa ~ |
    fa8 fa-.( fa-. fa-.) |
    fa-\sf r r4 |
    sol,,2-\p |
    sol8 r r4 |
    sol2-\p |
    re''8-\f r re4\sf ~ |
    re do,-\sf ~ |
    do do'8-\sf r |
    sol2-\f |
    do,-\dim ~ |
    do-\pp ~ |
    \repeat unfold 8 do ~ |
    do-\cresc ~ |
    \repeat unfold 2 do ~ |
    do4. do8 ~ |
    do2 ~ |
    \autoBeamOff
    do4 ~ do8.. mib'32-\ff |
    \autoBeamOn
    mib4 ~ mib8.. do32 |
    do,8 r r4 |
    R2 |
    r4 r8 mib' |
    do, r r4 |
    R2 * 2 |
    r16 fa'-. mib-. re-. re8 r |
    do,-\sf r r4 |
    r16 sol''-. fa-. mib-. do8 r |
    r16 sol' fa mi do-\sf fa fa fa |
    fa-\sf fa fa fa mib-\sf do, do do |
    sol2-\sf |
    sol''-\sf |
    fa8-.-\markup { \italic "ben marcato" } mib-. re-. do-. |
    sol8.-\sf r16 do8.-\sf r16 |
    sol8.-\sf r16 r4 |
    sol,2-\sf |
    sol8 sol sol do |
    R2 |
    fa'8.-\sf r16 mib8.-\sf r16 |
    re8.-\sf r16 re8.-\sf r16 |
    sib8.-\> r16 sib8. r16-\! |
    R2 * 6 |
    \bar "||"
    r4 mib8-\p r |
    r4 mib8 r |
    r4 mib8 r |
    r4 mib8 r |
    r8 mib4-\< mib8 |
    r mib4 mib8 |
    r mib4-\> mib8 |
    r mib4 mib8 |
    mib-\p r r4 |
    R2 * 5 |
    r4 fa16-\f fa ~ fa fa( |
    mib8) r mib-. r |
    R2 * 2 |
    fa2-\p-\cresc ~ |
    fa16 fa ~ fa fa ~ fa fa ~ fa mib ~ |
    mib mib ~ mib mib ~ mib mib ~ mib mib ~ |
    mib mib ~ mib mib ~ mib mib ~ mib mib |
    mib8-\ff re16.-. re32-. mib8 r |
    fa8-. mi16.-. mi32-. fa8 r |
    R2 * 2 |
    mib8-.-\ff re16.-. re32-. mib8 r |
    mi8-. mib16.-. mib32-. mi8 r |
    R2 * 14 |
}

corniB_I_mvtIV = \relative do''
{
    \transposition sib
    \time 3/4
    \tempo "Presto" 2. = 96
    
    \partial 4 sol4-\ff ~ |
    sol2. ~ |
    sol ~ |
    sol8 sol' sol r r mi |
    mi4 r r8 mi |
    mi mi mi mi mi mi |
    mi mi mi mi mi mi |
    mi4-. r r |
    R2. * 9 |
    r4 r fa-\ff ~ |
    fa2. ~ |
    fa ~ |
    fa4 fa fa |
    fa8 r r4 r |
    R2. * 2 |
    r4 r r8 re |
    re4 r r |
    R2. |
}

