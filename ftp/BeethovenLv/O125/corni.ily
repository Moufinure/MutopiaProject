corniD_I_mvtIV = \relative do''
{
    \transposition re
    \time 3/4
    \tempo "Presto" 2. = 96

    \partial 4 mib4-\ff ~ |
    mib2. ~ |
    mib ~ |
    mib4 mib mib |
    mib mib mib |
    mib8 do do do do do |
    do do do do do do |
    do4-. sol' r |
    R2. * 9 |
    r4 r sol-\ff ~ |
    sol2. ~ |
    sol ~ |
    sol4 sol sol |
    sol8 mi mi sol sol mi, |
    mi sib' sib r r4 |
    r r sol'8 sol |
    sol4 r r8 sol |
    sol4 r r |
    R2. * 3 |
    r4 do,8-\f r do r |
    \bar "||"
    \time 2/4
    \tempo "Allegro ma non troppo" 4 = 88
    re2-\pp ~ |
    \repeat unfold 6 { re ~ } |
    re( |
    \bar "||"
    \time 3/4
    \tempo "Tempo I."
    mi4-\f) r r |
    R2. * 6 |
    \tempo "Poco adagio"
    R2. * 3 |
    \bar "||"
    \tempo "Vivace"
    R2. * 8 |
    \tempo "Tempo I."
    R2. * 7 |
    \bar "||"
    \tempo "Adagio cantabile"
    R1 * 2 |
    \bar "||"
    \time 3/4
    \tempo "Allegro"
    R2. * 11 |
    r4 re2-\p
    \bar "||"
    \time 4/4
    \tempo "Allegro assai"
    sol,1 ~ |
    sol ~ |
    sol ~ |
    sol ~ |
    \bar "||"
    \time 3/4
    \tempo "Tempo I."
    sol4 re'-\f r |
    r re r |
    r re r |
    r mi r |
    R2. * 3 |
    r4 fa-\f fa8 r |
    R2. * 2 |
    re4-\ff r mi |
    \bar "||"
    \time 4/4
    \tempo "Allegro assai" 2 = 88
    R1 * 72 |
    mi2-\f( fa4 sol) |
    sol( fa) mi-.( re-.) |
    do do( re mi) |
    mi4.( re8) re2 |
    do2-\f( fa4 sol) |
    sol( fa) mi-.( re-.) |
    do-.( do-. re-. mi-.) |
    re4.( do8) do2 |
    re( mi4 do) |
    re( mi8 fa) mi4 do |
    re( mi8 fa) mi4 mi, |
    mi'-! re-! sol,-! mi' ~ |
    mi mi-.( fa-. sol-.) |
    sol( fa) mi-.( re-.) |
    do-.( do-. re-. mi-.) |
    re4.( do8) do-! sol'( fa mi) |
    re2-\sf mi4( do) |
    re( mi8 fa mi4) do |
    re( mi8 fa) mi4 mi |
    mi-! re-! sol,-! mi' ~ |
    mi mi-.( fa-. sol-.) |
    sol( fa) mi-.( re-.) |
    do do-.( re-. mi-.) |
    re4.( do8) do4 sol' |
}

