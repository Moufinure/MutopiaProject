}

corniD_I_mvtIV = \relative do''
{
    \transposition re
    \time 3/4
    \tempo "Presto" 2. = 96
    
    \partial 4 mib4-\ff ~ |
    mib2. ~ |
    mib ~ |
    mib4 mib mib |
    mib mib mib |
    mib8 do do do do do |
    do do do do do do |
    do4-. sol' r |
    R2. * 9 |
    r4 r sol-\ff ~ |
    sol2. ~ |
    sol ~ |
    sol4 sol sol |
    sol8 mi mi sol sol mi, |
    mi sib' sib r r4 |
    r r sol'8 sol |
    sol4 r r8 sol |
    sol4 r r |
    R2. |
}

corniD_II_mvtIV = \relative do''
{
    \transposition re
    \time 3/4
    \tempo "Presto" 2. = 96
    
    \partial 4 do4-\ff ~ |
    do2. ~ |
    do ~ |
    do4 do do  |
    do do do |
    do8 do, do do do do |
    do do do do do do |
    do4-. sol' r |
    R2. * 9 |
    r4 r mi'-\ff ~ |
    mi2. ~ |
    mi ~ |
    mi4 mi mi |
    mi8 mi, mi sol sol mi |
    mi sib' sib r r4 |
    r r sol8 sol |
    sol4 r r8 sol |
    sol4 r r |
    R2. |
}