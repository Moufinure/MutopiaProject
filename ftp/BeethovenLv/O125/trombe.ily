\include "italiano.ly"

trombeI_mvtI = \relative do''
{
    \clef treble
    \time 2/4
    \tempo "Allegro ma non troppo, un poco maestoso" 4 = 88
    
    R2 * 15 |
    r4 r8 r16. do32-\ff |
    sol4 ~ sol8.. do32 |
    do8.. sol32 do8. do32 do |
    do4 ~ do16 do-. do-. do-. |
    sol8 sol-. sol-. sol-. |
    do-\sf r sol-\sf r |
    do-\sf r r4 |
    do8-\sf r do-\sf r |
    fa r r4 |
    R2 * 2 |
    r8 sol,16.-\f sol32 sol8 sol |
    sol-\p r r4 |
    sol8 sol16. sol32 sol8 sol |
    sol-\p r r4 |
    sol8-\f r sol-\sf r |
    r4 do8-\sf r |
    r4 do8-\sf r |
    sol2-\f |
    r4 do,8-\p r |
    R2 * 14 |
    r4 r8 r16. do'32-\ff |
    do4 ~ do8.. do32 |
    do8.. do32 do8. do32 do |
    do8 r r4 |
    R2 |
    do8 r r4 |
    do8 r r4 |
    re8-\sf r r4 |
    R2 |
    do8-\sf r r16 do-. do-. do-. |
    do8-\sf r r16 do do do |
    do8-\sf r r16 do do do |
    do-\sf do do do do-\sf do do do |
    sol8 r r4 |
    sol8-\sf sol-\markup { \italic "ben marcato" } sol sol |
    sol sol sol sol |
    re'8.-\sf r16 do8.-\sf r16 |
    sol8.-\sf r16 r4 |
    sol8 sol sol sol |
    sol sol sol do |
    R2 * 3 |
    sol8.-\> r16 sol8. r16 |
    sol8-\p r r4 |
    R2 * 20 |
    do8-.-\f r sib-. r |
    R2 * 6 |
    do8-.-\ff do16.-. do32-. do8 r |
    R2 * 3 |
    do8-.-\ff do16.-. do32-. do8 r |
    R2 * 15 |
}

trombeII_mvtI = \relative do'
{
    \clef treble
    \time 2/4
    \tempo "Allegro ma non troppo, un poco maestoso" 4 = 88
    
    R2 * 15 |
    r4 r8 r16. do32-\ff
    sol4 ~ sol8.. do32 |
    do8.. sol32 do8. do32 do |
    do4 ~ do16 do-. do-. do-. |
    sol8-. sol-. sol-. sol-. |
    do-\sf r sol-\sf r |
    do-\sf r r4 |
    do8-\sf r do-\sf r |
    fa' r r4 |
    R2 * 2 |
    r8 sol,,16.-\f sol32 sol8 sol |
    sol-\p r r4 |
    sol8-\f sol16. sol32 sol8 sol |
    sol-\p r r4 |
    sol8-\f r sol-\sf r |
    r4 do8-\sf r |
    r4 do8-\sf r |
    sol2-\f |
    r4 do8-\p r |
    R2 * 14 |
    r4 r8 r16. do32-\ff |
    do4 ~ do8.. do32 |
    do8.. do32 do8. do32 do |
    do8 r r4 |
    R2 |
    do8 r r4 |
    do8 r r4 |
    re'8-\sf r r4 |
    R2 |
    do,8-\sf r r16 do-. do-. do-. |
    do8-\sf r r16 do do do |
    do8-\sf r r16 do do do |
    do-\sf do do do do-\sf do do do |
    sol8 r r4 |
    sol8-\sf sol-\markup { \italic "ben marcato" } sol sol |
    sol sol sol sol |
    sol'8.-\sf r16 do,8.-\sf r16 |
    sol8.-\sf r16 r4 |
    sol8 sol sol sol |
    sol sol sol do |
    R2 * 3 |
    sol8.-\> r16 sol8. r16 |
    sol8-\p r r4 |
    R2 * 20 |
    do8-.-\f r sol-. r |
    R2 * 6 |
    do8-.-\ff do16.-. do32-. do8 r |
    R2 * 3 |
    do8-.-\ff do16.-. do32-. do8 r |
    R2 * 15 |
}

trombeI_mvtIV = \relative do''
{
    \transposition re
    \time 3/4
    \tempo "Presto" 2. = 96
    
    \partial 4 sol4-\ff ~ |
    sol4. sol8-. sol-. do-. |
    do4 r8 sol sol do, |
    do4 r8 sol' sol do |
    do4 r8 sol' sol do, |
    do do do do do do |
    do do do do do do |
    do4-. sol-. r |
    R2. * 8 |
    r4 r do-\ff ~ |
    do2. |
    sib4. sib8-. sib-. sib-. |
    sib mi, mi sol sol sib |
    sib4 r8 sib sib sib |
    sib mi, mi sol sol sib |
    sib4 r8 do do sib |
    sib4 r8 sib sib sib |
    sib4 r r8 sib |
    sib4 r r |
    R2.  * 3 |
    r4 do8-\f r do r |
    \bar "||"
    \time 2/4
    \tempo "Allegro ma non troppo" 4 = 88
    sol4-\p r |
    R2 * 2 |
    r4 r8 r16. sol32-\pp |
    sol4 r |
    R2 * 2 |
    r4 r8 r16. sol32 |
    \bar "||"
    \time 3/4
    \tempo "Tempo I."
    sol4-\f r r |
    R2. * 6 |
    \tempo "Poco adagio"
    R2. * 3 |
    \bar "||"
    \tempo "Vivace"
    R2. * 8 |
    \tempo "Tempo I."
    R2. * 7 |
    \bar "||"
    \key do \major
    \time 4/4
    \tempo "Adagio cantabile"
    R1 * 2 |
    \bar "||"
    \time 3/4
    \tempo "Allegro"
    R2. * 12 |
    \bar "||"
    \time 4/4
    \tempo "Allegro assai"
    R1 * 4 |
    \bar "||"
    \time 3/4
    \tempo "Tempo I."
    R2. * 2 |
    r4 sol-\f r |
    r do2:8-\f |
    do4 r r |
    R2. * 2 |
    r4 do-\f do8 r |
    R2. * 2 |
    re4-\ff r do |
    \bar "||"
    \time 4/4
    \tempo "Allegro assai" 2 = 88
    R1 * 72 |
    mi2-\f( fa4 sol) |
    sol( fa) mi-.( re-.) |
    do do( re mi) |
    mi4.( re8) re2 |
    mi( fa4 sol) |
    sol( fa) mi-.( re-.) |
    do-.( do-. re-. mi-.) |
    re4.( do8) do2 |
    re( mi4 do) |
    re( mi8 fa) mi4 do |
    re( mi8 fa) mi4 mi, |
}

trombeII_mvtIV = \relative do'
{
    \transposition re
    \time 3/4
    \tempo "Presto" 2. = 96
    
    \partial 4 sol4-\ff ~ |
    sol4. sol8-. sol-. do-. |
    do4 r8 sol' sol do, |
    do4 r8 sol sol do |
    do4 r8 sol' sol do, |
    do do do do do do |
    do do do do do do |
    do4-. sol-. r |
    R2. * 8 |
    r4 r do-\ff ~ |
    do2. |
    sib'4. sib8-. sib-. sib-. |
    sib mi, mi sol sol sib |
    sib4 r8 sib sib sib |
    sib mi, mi sol sol sib |
    sib4 r8 do do sib |
    sib4 r8 sol sol sol |
    sol4 r r8 sol |
    sol4 r r |
    R2. * 3 |
    r4 do,8-\f r do r |
    \bar "||"
    \time 2/4
    \tempo "Allegro ma non troppo" 4 = 88
    sol4-\p r |
    R2 * 2 |
    r4 r8 r16. sol32-\pp |
    sol4 r |
    R2 * 2 |
    r4 r8 r16. sol32 |
    \bar "||"
    \time 3/4
    \tempo "Tempo I."
    sol4-\f r r |
    R2. * 6 |
    \tempo "Poco adagio"
    R2. * 3 |
    \bar "||"
    \tempo "Vivace"
    R2. * 8 |
    \tempo "Tempo I."
    R2. * 7 |
    \bar "||"
    \key do \major
    \time 4/4
    \tempo "Adagio cantabile"
    R1 * 2 |
    \bar "||"
    \time 3/4
    \tempo "Allegro"
    R2. * 12 |
    \bar "||"
    \time 4/4
    \tempo "Allegro assai"
    R1 * 4 |
    \bar "||"
    \time 3/4
    \tempo "Tempo I."
    R2. * 2 |
    r4 sol-\f r |
    r do2:8-\f |
    do4 r r |
    R2. * 2 |
    r4 do-\f do8 r |
    R2. * 2 |
    sol'4-\ff r mi |
    \bar "||"
    \time 4/4
    \tempo "Allegro assai" 2 = 88
    R1 * 72 |
    do'2-\f( re4 mi) |
    mi( re) do-.( sol-.) |
    mi mi( sol do) |
    do4.( sol8) sol2 |
    do2( re4 mi) |
    mi( re) do-.( sol-.) |
    mi-.( mi-. sol-. do-.) |
    sol4.( mi8) mi2 |
    sol( do4 mi,) |
    sol( do8 re do4) mi, |
    sol( do8 re) mi,4 mi |
  }