sempreff = #(make-dynamic-script 
             (markup #:line (#:normal-text #:italic "sempre" #:dynamic "ff")))
sempref = #(make-dynamic-script
            (markup #:line (#:normal-text #:italic "sempre" #:dynamic "f")))
semprep = #(make-dynamic-script
            (markup #:line (#:normal-text #:italic "sempre" #:dynamic "p")))
semprepp = #(make-dynamic-script
             (markup #:line (#:normal-text  #:italic"sempre" #:dynamic "pp")))
piuf = #(make-dynamic-script 
         (markup #:line (#:normal-text #:italic "più" #:dynamic "f")))
piup = #(make-dynamic-script
         (markup #:line (#:normal-text #:italic "più" #:dynamic "p")))
semprepiup = #(make-dynamic-script
               (markup #:line (#:normal-text #:italic "sempre più" #:dynamic "p")))
pdolce = #(make-dynamic-script
           (markup #:line (#:dynamic "p" #:normal-text #:italic "dolce")))
