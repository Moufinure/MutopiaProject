\language "italiano"

pianoI_I_right = \relative do'
{
    \key fa \major
    \tempo "Allegro"
    
    R1 * 22 |
}

pianoI_I_left = \relative do
{
    \clef bass
    \key fa \major
    \tempo "Allegro"
    
    fa4-\f r r fa |
    do r r do |
    fa mi r2 |
    R1 * 4 |
    fa4 r r fa |
    do r r do |
    fa mi r2 |
    R1 * 12 |
}

