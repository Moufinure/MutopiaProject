violinII_I = \relative do''
{
    \key fa \major
    \tempo "Allegro"
    
    <la fa'>4-\f la8. do16 fa4 <fa, do' fa> |
    <mi do' sol'> do'8. mi16 sol4 <mi, do' sol'> |
    <fa do' la'> <mi do' sib'> r2 |
    r8 sol-\p( sib sol) r mi( sol mi) |
    r fa( la fa) r dod( mi dod) |
    r re( fa re) r sib( re sib) |
    r do( la' do,) r do( sol' do,) |
    <fa do' fa>4-\f la8. do16 fa4 <fa, do' fa> |
    <mi do' sol'> do'8. mi16 sol4 <mi, do' sol'> |
    <fa do' la'> <mi do' sib'> r2 |
    r8 sol-\p( sib sol) r mi( sol mi) |
    r fa( la fa) r dod( mi dod) |
    r re( fa re) r do( mib do) |
    r sib( re sib) r si( sol' si,) |
    do4 do'16-\f( si do re mi8-.) r mi16( re mi fa |
    sol8) r sol16( fa sol la) sib8-. la-. sib-. sol-. |
    la r la,8.-\p( fa16) sib8-. r sib8.( sol16) |
    do8-. r do4.( re16 do sib8-.) la-. |
    sol r do16-\f( si do re mi8) r mi16( re mi fa |
    sol8) r sol16( fa sol la) sib8-. la-. sib-. sol-. |
    la-. r la,8.-\p( fa16) sib8-. r sib8.( sol16) |
    do8-. r do4.( re16 do sib8) la-. |
}

violaI = \relative do
{
    \key fa \major
    \tempo "Allegro"
    
    fa4-\f r r fa |
    do r r do |
    fa mi r2 |
    R1 * 4 |
    fa4 r r fa |
    do r r do |
    fa mi r2 |
    R1 * 4 |
    r2 r4 do'16( si do re |
    mi8) r mi16( re mi fa) mi8-. fa-. mi-. sol-. |
    do, r fa8.-\p( do16) sol'8-. r sol8.( mi16) |
    la8-. r la4.( sib16 la) sol8-. fa-. |
    mi r r4 r do16-\f( si do re |
    mi8-.) r mi16( re mi fa) mi8-. fa-. mi-. sol-.  |
    do,-. r fa8.-\p( do16) sol'8-. r sol8.-.( mi16) |
    la8-. r la4.( sib16 la sol8) fa-. |
}

bassoI = \relative do
{
    \key fa \major
    \tempo "Allegro"
    
    fa4-\f r r fa |
    do r r do |
    fa mi r2 |
    R1 * 4 |
    fa4 r r fa |
    do r r do |
    fa mi r2 |
    R1 * 4 |
    r2 r4 do16( si do re) |
    mi8 r mi16( re mi fa) sol8-. fa-. sol-. mi-. |
    fa8-. r r4 r2 |
    R1 |
    r2 r4 do16( si do re |
    mi8) r mi16( re mi fa) sol8-. fa-. sol-. mi-. |
    fa r r4 r2 |
    R1 |
}