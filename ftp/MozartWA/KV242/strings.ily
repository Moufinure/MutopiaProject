    <mi do' sol'> do'8. mi16 sol4 <mi, do' sol'> |
    <fa do' la'> <mi do' sib'> r2 |
    sib''( re |
    do sib |
    la fad) |
    sol4( re') re,( fa) |
    mi8 do'4-\f do do do8 ~ |
    do do4 do do do8 ~ |
    do do,4-\p do do do8 ~ |
    do do4 do do do8 ~ |
    do do'4-\f do do do8 ~ |
    do do4 do do do8 ~ |
    do do,4 do do do8 ~ |
