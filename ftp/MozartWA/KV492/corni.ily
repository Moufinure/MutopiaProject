corniI_actI_nI = \relative do''
{
    \transposition sol
    \tempo "Allegro"
    
    R1 * 5 |
    re1-\f |
    do2. mi4 |
    re2 re |
    re8 sol, sol sol sol2-\p ~ |
    sol1 ~ |
    sol8-\sf sol sol sol sol2-\p ~ |
    sol1 ~ |
    sol8-\sf sol sol sol sol2-\p ~ |
    sol1 ~ |
    sol4 r r2 |
    do8-\f do16 do do8 do do2 |
    do4 mi8. mi16 mi4 re |
    do do-\p sol mi |
    do r r2 |
    R1 * 10 |
    r8 sol'-\mf sol sol sol2-\p ~ |
    sol1 ~ |
    sol8-\mf sol sol sol sol2-\p ~ |
    sol1 ~ |
    sol4 r r2 |
    r mi'8 r re r |
    do4 r r2 |
    R1 |
    sol ~ |
    sol ~ |
    sol ~ |
    sol ~ |
    sol2. do4 |
    R1 * 3 |
    re1 ~ |
    re ~ |
    re8-\cresc re re re re re re re |
    re4-\f r r2 |
    R1 * 4 |
    r2 re8-\p r re r |
    sol,1 ~ |
    sol4 r r2 |
    sol1 ~ |
    sol4 r r2 |
    sol1 ~ |
    sol ~ |
    sol ~ |
    sol ~ |
    sol ~ |
    sol4 r r2 |
    r4 sol sol r |
    r sol sol r |
    r2-\fermata sol 
}

