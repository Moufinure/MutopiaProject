\language "italiano"

harmonika_right_adagio = \relative do''
{
    \key do \minor
    \time 6/8
    \tempo "Adagio"
    
    do4.-\f( ~ mib8 ~ <do mib sol>) r <mib sol> ~ |
    <mib sol>( <re fa> <do mib>)
}

harmonika_left_adagio = \relative do'
{
    \key do \minor
    
    <do mib sol>4. ~ <do mib sol>8 r r |
}