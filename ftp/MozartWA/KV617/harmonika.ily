\language "italiano"

harmonika_right_adagio = \relative do''
{
    \key do \minor
    \time 6/8
    \tempo "Adagio"
    
    <<
      {
	s4 mib8 ~ <mib sol> r
      }
      \\
      {
	do4.-\f ~ do 8 r
      }
    >>
    <mib sol> ~ |
    <mib sol>-\p( <re fa> <do mib>) <re fa>32( <do mib> <si re> <do mib>) <si re>8-. r |
    <<
      {
	s4 fa'8 ~ <fa lab> r fa ~ |
	fa( mib re) re16.( mib32) do8-. r |
	do'4.( sib8) r r |
      }
      \\
      {
	<si, re>4. ~ <si re>8 r re-\p ~ |
	re( do si) si do-. r |
	sol'4.( fa8) r r |
      }
    >>
    lab8.-\p( sol32 lab sol lab sib lab sol8) r r |
    r4. r4 do8 |
    mib4( fad,16. sol32) sol8.( fad16 fa re) |
    <<
      {
	s4 mib8 ~ <mib sol> r r |
      }
      \\
      {
	do4.-\f ~ do8 r r |
      }
    >>
    R2. |
    <<
      {
	s4 lab'8 ~ <lab do> r r |
      }
      \\
      {
	<re, fa>4. ~ <re fa>8 r r |
      }
    >>
    r4. r4 sib'8-\p ~ |
    sib( lab sol) ~ sol( fa mib) |
    <<
      {
	re( <fa lab> <mib sol> <re fa>) r r |
      }
      \\
      {
	r sib4 ~ sib8 r r |
      }
    >>
    fa'4 \appoggiatura lab32 solb16. fa32 fa8 r r |
    fa8-.( solb16-. sol-. lab-. la-.) sib8 sib16( lab sib do) |
    sib8.( do32 sib lab sol fa mib) mib8-.( mib-. mib-.) |
    mi16( fa sol fa) fa8-. r4. |
    do'8.( re32 do sib lab sol fa) fa8-.( fa-. fa-.) |
    fad16( sol lab sol) sol8-. r4. |
    r16 \grace { sib32( lab sol) } lab16( mib' do lab sol) fad8 r r |
    r16 \grace { la32( sol fad) } sol16( re' sib sol fa) mi8 r r |
    r16 \grace { sol32( fa mi) } fa16( do' lab fa mib) re8 r r |
    r16 \grace { fa32( mib re) } mib16( solb mib dob sib) la4. |
    sib32( do re mib mi fa fad sol lab la sib si) <lab do>4. |
    <sol sib>8( <fa lab> <mib sol>) mi16( fa) fa( sol) sol( lab) |
    sib-.( la-. lab-. sol-. solb-. fa-.) mib8-. r16 \grace { fa32( mib re) } mib16( sol fa) |
    mib8 r r r4. |
    r4 <sol sib>8 ~ <sol sib>( <fa lab> <mib sol> |
    <re fa> <mib sol>) r r4. |
    <<
      {
	fa4. solb ~ |
	solb fa |
	mi8 r r r4. |
      }
      \\
      {
	mib2. |
	reb4. dob |
	sib8 r r r4. |
      }
    >>
    R2. |
    r8 r sib' \grace { do32( sib la sib) } do16-.( sib-. lab-. sol-. fa-. mib-. ) |
    re8 r lab' \grace { sib32( lab sol lab) } sib16-.( lab-. sol-. fa-. mib-. re-.) |
    mib8 r r r4. |
    r re32( mib fa fad sol lab la sib si do dod re) |
    mib8 r r
    <<
      {
	<sol,, si> r r |
	s4 mib'8 ~ <mib sol> r sol-\p ~ |
	sol( fa mib) fa32( mib re mib) re8-. r |
	s4 fa8 ~ <fa lab> r fa ~ |
	fa( mib re) re16.( mib32) do8-. r |
	do'4.-\f( sib8) r r |
      }
      \\
      {
	fa,8-\f r r |
	do'4. ~ do8 r mib-\p ~
	mib( re do) re32( do si do) si8-. r |
	<si re>4.-\f ~ <si re>8 r re-\p ~ |
	re( do si) si do r |
	sol'4.( fa8) r r |
      }
    >>
    lab8.-\p( sol32 lab sol lab sib lab sol8) r r |
    r4. r4 do8 |
    mib4( fad,16. sol32) sol8.( fad16 fa re) |
    <<
      {
	s4 mib8 ~ <mib sol>
      }
      \\
      {
	do4.-\f ~ do8
      }
    >> r r |
    R2. |
    <<
      {
	s4 sib'8 ~ <sib reb>
      }
      \\
      {
	<mi, sol>4. ~ <mi sol>8
      }
    >> r r |
    r4. r4
    <<
      {
	do'8-\p( |
	sib lab sol fad4.) |
	sol8
      }
      \\
      {
	s8 |
	s4 do,8 do16( si do mib re do) |
	si8
      }
    >> r r r4. |
    R2. |
    r32 sol'( fad sol lab sol fad sol) si-. sol( fad sol) do-. sol( fad sol) re'-. sol,( fad sol) mib'-. sol,( fad sol) |
    re'8 r r r4. |
    r4 <re, sol>8 <re sol> r <sol si re>-\f |
    <sol si re>2.-\fermata |
    \bar "||"
    \key do \major
    \time 2/2
    \tempo "Allegretto"
    mi4.( fa8 la sol fa mi) |
    mi( fa dod re) re4 r |
    fa4.( sol8 si la sol fa) |
    fa( sol red mi) mi sol-. la-. si-. |
    do4.( si16 la sol8) sol-. la-. si-. |
    do4.( si16 la sol8) sol-. la-. si-. |
    re( do) do( si) si( la) la( sol) |
    re4.( mi16 fad sol4) r |
    R1 * 9 |
    r2 \tuplet 3/2 4 { r8 sol( fa mi re do) |
		       si( re do si fa' mi re la' sol fa mi re) |
		     }
    mi4 r \tuplet 3/2 4 { r8 sol( fa mi re do) |
			  si( re do si fa' mi re la' sol fa mi re) |
			}
    mi4 r \tuplet 3/2 4 { r8 mi'( re do si la) } |
    sold2( \tuplet 3/2 4 { la8) do( sib la sol fa) } |
    mi2( \tuplet 3/2 4 { fa8) la( sol fa mi re) } |
    dod2( re8) \tuplet 3/2 { mi16( re do } re8 mi) |
    fa1 ~ |
    fa8( mi re dod re mi fa fad) |
    sol4.( la16 si do8 sol fa mi) |
    mi( re mi fa do4 si) |
    do2 r |
    R1 * 2 |
    <<
      {
	mi'2( re |
	do sib |
	la sold) |
	la4
      }
      \\
      {
	sol2 sold |
	la fa |
	mi re |
	do4
      }
    >> r4 r2 |
    R1 * 3 |
    mib'4.( sol,8) lab-. \grace { sib32( la sol) } la8( do la) |
    mib'4.( sol,8) lab-. \grace { sib32( la sol) } la8( do la) |
    dod4 << { dod2 dod4 | re } \\ { sib4 la sol | fad } >> r8 re-.( mi-. fa-. sol-. la-.) |
    si4 r8 si( la4) r8 la( |
    sol4) r8 fad-.( sol-. sold-. la-. si-.) |
    do4 r8 <la do>( <sol si>4) r8 <sol si>( |
    <fad la>4) r8 fad-.( sol-. la-. si-. do-.)
    re4 r8 <si re>( <la do>4) r8 <la do>( |
    <sol si>4) r8 mi'-.( re-. <mi, do'>-. <re si'>-. <do la'>-.) |
    <si sol'>4 r8 <re sol>( <do fad>4) r8 <do fad>( |
    <si sol'>4) r r2 |
    r4 \tuplet 3/2 { si8( re sol) } r4 \tuplet 3/2 { la,8( re fad) } |
    r4 \tuplet 3/2 { si,8 re sol } r2 |
    r4 \tuplet 3/2 { re8 la' do } r4 \tuplet 3/2 { re,8 sol si } |
    r4 \tuplet 3/2 { re,8 fad la } r2 |
    r4 \tuplet 3/2 { sol8 si re } r4 \tuplet 3/2 { fad,8 la do } |
    r4 \tuplet 3/2 { mi,8 sol si } r4 \tuplet 3/2 { mi,8 la do } |
    r4 \tuplet 3/2 { re,8 sol si } r4 \tuplet 3/2 { re,8 fad la } |
    \tuplet 3/2 4 { sol( la fad sol si la sol re'do si la sol) } |
    fad1 |
    \tuplet 3/2 4 { sol8( la fad sol si la sol re' do si la sol) } |
    fad1 |
    \tuplet 3/2 4 { fa8( sol mi fa si lad si re dod re fa mi) } |
    fa2 ~ fa8( re dod mi |
    re si la do si sol fad la |
    sol sold la sold si la sol fa) |
    mi4.( fa8 la sol fa mi) |
    mi( fa dod re) re4 r |
    fa4.( sol8 si la sol fa) |
    fa( sol red mi) mi sol-. la-. si-. |
    do4.( si16 la sol8) sol-. la-. si-. |
    do4.( si16 la sol8) sol-. la-. si-. |
    re( do) do( si) si( la) la( sol) |
    re4.( mi16 fad sol4) r |
    R1 * 10 |
    <<
      {
	do1 ~ |
	do ~ |
	<fa, do'>2 <do mi> |
      }
      \\
      {
	do'2( sib |
	la sol |
	do, sib) |
      }
    >>
    <la do fa>4 r r2 |
    R1 * 7 |
    fa'4.( sol32 fa mi fa la8) r r4 |
    sol4.( la32 sol fad sol sib8) r r4 |
    <<
      {
	la sib do re8 sib |
	la4.( sib16 la sol8) do( sib sol)
      }
      \\
      {
	fa4 fa fa fa |
	fa2 mi8 s4.
      }
    >> |
    fa4.( sol32 fa mi fa la8) r r4 |
    sol4.( la32 sol fad sol sib8) r r4 |
    la8( do) r fa,-. sol( sib) r mi,-. |
    <mi sol>2( fa8) \grace { sol32( fa mi) } fa8( la fa) |
    <mi do'>2( <fa si> |
    <sol sib> <fa la> ~ |
    <fa lab> <reb solb> |
    <re fa> <do mi>8) do16( mi re fa mi sol) |
    fa4.(  sol32 fa mi fa la8) r r4 |
    sol4.( la32 sol fad sol sib8) r r4 |
    la8( do) r fa,-. sol( sib) r mi,-. |
    <mi sol>2( fa4) r |
    R1 * 7 |
    r2 r8 la,( do fa) |
    <do la'>2( <dod sol'> |
    <re fa> <sib mib> |
    <la re> <sol dod>) |
    re'4 r r2 |
    R1 * 3 |
    lab'4.( do,8) reb-. \grace { mib32( reb do) } reb8( fa reb) |
    lab'4.( do,8) reb-. \grace { mib32( reb do) } reb8( fa reb) |
    fad4 << { fad2 fad4 | sol2 } \\ { mib4 re do | si r4 } >> fad'8( sol lab sol) |
    sol4.( lab8 do sib lab sol) |
    sol( lab mi fa) fa4 r |
    lab4.( sib8 re do sib lab) |
    lab( sib fad sol) sol sib-. do-. re-. |
    mib4.( re16 do sib8) sib-. do-. re-. |
    mib4.( re16 do sib8) sib-. do-. re-. |
    fa( mib) mib( re) re( do) do( sib) |
    fa4.( sol16 la sib4) r |
    R1 * 3 |
    sol1 |
    fa4.( sib8 do sib lab sol) |
    lab1 |
    sol4.( do8 re do sib la) |
    sib1 |
    R1 * 3 |
    r4 r8 sol,-.( la-. si-. do-. re-.) |
    mi4 r8 mi( re4) r8 re( |
    do4) r8 si-.( do-. dod-. re-. mi-.) |
    fa4 r8 <re fa>( <do mi>4) r8 <do mi>( |
    <si re>4) r8 si-.( do-. re-. mi-. fa-.) |
    sol4 r8 <mi sol>( <re fa>4) r8 <re fa>( |
    <do mi>4) r8 do'( sold la fa re) |
    sol4 r8 sol( si,4) r8 <fa si>( |
    <mi do'>4) r r2 |
    r4 \tuplet 3/2 { sol8( do mi) } r4 \tuplet 3/2 { sol,8( si re) } |
    r4 \tuplet 3/2 { sol,8 do mi } r2 |
    r4 \tuplet 3/2 { sol,8 re' fa } r4 \tuplet 3/2 { sol,8 do mi } |
    r4 \tuplet 3/2 { sol,8 si re } r2 |
    r4 \tuplet 3/2 { sol8 do mi } r4 \tuplet 3/2 { fa,8 si re } |
    r4 \tuplet 3/2 { mi,8 la do } r4 \tuplet 3/2 { fa,8 la re } |
    r4 \tuplet 3/2 { mi,8 sol do } r4 \tuplet 3/2 { re,8 fa si } |
    \tuplet 3/2 4 { do,( re si do mi re do sol' fa mi re do) } |
    si1 |
    \tuplet 3/2 4 { mi8( fa re mi sol fa mi sib' la sol fa mi) } |
    fa4 r r2 |
    r4 \tuplet 3/2 { sol8 la mi' } r4 \tuplet 3/2 { fad,8 la re } |
    r4 \tuplet 3/2 { fa,8 sol re' } r4 \tuplet 3/2 { mi,8 sol do } |
    \tuplet 3/2 4 { re,8( mi dod re fad mi re la' sol fad do' si } |
    la mi' re do si la sol fad) |
    sol8( \tuplet 3/2 { la16 sol fad } sol8 la) si( \tuplet 3/2 { do16 si la } si8 do) |
    re8( \tuplet 3/2 { mi16 re dod } re8 mi) fa( re dod mi) |
    re( si la do si sol fad la |
    sol-\markup { \italic "rallent." } fad la sol si la sol fa) |
    mi4.( fa8 la sol fa mi) |
    mi( fa dod re) re4 r |
    fa4.( sol8 si la sol fa) |
    fa( sol red mi) mi sol-. la-. si-. |
    do4.( si16 la sol8) sol-. la-. si-. |
    do4.( si16 la sol8) sol-. la-. si-. |
    re( do) do( si) si( la) la( sol) |
    re4.( mi16 fad sol4) r |
    R1 * 9 |
    r2 \tuplet 3/2 4 { r8 sol( fa mi re do) |
		       si( re do si fa' mi re la' sol fa mi re) }
    mi4 r \tuplet 3/2 4 { r8 sol( fa mi re do) |
			  si( re do si fa' mi re la' sol fa mi re) |
			}
    mi4 r \tuplet 3/2 4 { r8 mi'( re do si la) } |
    sold2( \tuplet 3/2 4 { la8) do( sib la sol fa) } |
    mi2( \tuplet 3/2 4 { fa8) la( sol fa mi re) } |
    dod2( re8) \tuplet 3/2 { mi16( re do } re8 mi) |
    fa1 ~ |
    fa8( mi re dod re mi fa fad) |
    sol4.( la16 si do8 sol fa mi) |
    mi( re mi fa do4 si) |
    do2 r |
    R1 * 3 |
    r2 r8 do'16( si re do si la) |
    la8( sol) fad( sol) fad( sol) la( sol) |
    sol( \tuplet 3/2 { la16 sol fad } sol8 do) sol4 r |
    R1 ||
    r2 r8 do16( si re do si la) |
    la8( sol) fad( sol) fad( sol) fa( re) |
    do4 r8 sol'-.( la-. si-. do-. re-.) |
    mi4 r8 <sol, mi'>( <fa re'>4) r8 <fa re'>( |
    <mi do'>4) r r2 |
    R1 |
    r4 r8 sol \tuplet 3/2 4 { la si do dod re red } |
    mi4 r8 <sol, mi'>8( <fa re'>4) r8 <fa re'>( |
    <mi do'>4) r r2 |
    R1 * 2 |
    r4 r8 mi'( fa re si re) |
    do4 r r2 |
    r4 r8 mi( fa re si re) |
    do4 r <sol mi'> r |
    <mi sol do>2 r |
}

harmonika_left_adagio = \relative do'
{
    \key do \minor
    
    <do mib sol>4. ~ <do mib sol>8 r r |
    mib8( fa fad) sol4 r8 |
    \clef bass
    <<
      {
	<si, re>4. ~ <si re>8 r r |
	<si re>( <do mib> <re fa>) fa( mib) r |
	\clef treble
	sol4.( sib8) r r |
	mib4.( re8) r r |
      }
      \\
      {
	<fa,, lab>4. ~ <fa lab>8 r r |
	r4 sol8 do4 r8 |
	mib4.( re8) r r |
	do'4.( si8) r r |
      }
    >> |
    R2. * 2 |
    <do, mib sol>4. ~ <do mib sol>8 r r |
    R2. |
    <sib re fa lab>4. ~ <sib re fa lab>8 r r |
    R2. |
    <<
      {
	mib'4( re8 do4 sib8) |
	lab r4 r4. |
	mib'4.( re8) r r |
	<do mib>4.( re8) r r |
	sol,16 sib sol sib sol sib sol sib sol sib sol sib |
	lab do lab do lab do lab do lab do lab do |
	lab sib lab sib lab sib lab sib lab sib lab sib |
	mib, sib' mib, sib' mib, sib' mib, sib' mib, sib' mib, sib' |
	mib4.( re8) r r |
	re4( reb8 do) r r |
	do4( dob8 sib) r r |
	sib4( solb8 mib) r r |
	<re fa> r r fa4. |
	sol8( lab sib do sib lab) |
	sol r r r4 lab8 |
	sol r r r4. |
	r4 sol8 ~ sol( lab sib |
	dob sib) r r4. |
	r8 dob-.( dob-.) r do-.( do-.) |
	r <solb sib>-.( <solb sib>-.) r <fa lab>-.( <fa lab>-.) |
      }
      \\
      {
	do'4( sib8 lab4 sol8) |
	fa( re mib sib) r r |
	<la' do>4.( sib8) r r |
	fa4.( sib8) r r |
	mib,8 mib mib mib mib mib |
	mib mib mib mib mib mib |
	re re re re re re |
	reb reb reb reb reb reb |
	do'4. ~ do8 r r |
	sib4. ~ sib8 r r |
	lab4. ~ lab8 r r |
	solb4( mib8 dob) r r |
	sib8 r r re4. |
	mib8( fa sol lab sol fa) |
	sib, r r r4 sib8 |
	mib r r r4. |
	r4 mib8 ~ mib( fa sol |
	lab sol) r r4. |
	r8 lab-.( lab-.) r la-.( la-.) |
	r reb,-.( reb-.) r reb-.( reb-.) |
      }
    >>
    R2. * 5 |
    r8 <do mib fa> <do mib fa> <sib re fa> r r |
    r4. <sol re'>8 r r |
    <do mib sol>4. ~ <do mib sol>8 r r |
    mi( fa fad) sol4 r8 |
    \clef bass
    <<
      {
	<si, re>4. ~ <si re>8 r r |
	<si re>( <do mib> <re fa>) fa( mib) r |
	\clef treble
	sol4.( sib8) r r |
	mib4.( re8) r r |
      }
      \\
      {
	<fa,, lab>4. ~ <fa lab>8 r r |
	r4 sol8 do4 r8 |
	mib4.( re8) r r |
	do'4.( si8) r r |
      }
    >>
    R2. * 2 |
    <do, mib sol>4. ~ <do mib sol>8 r r |
    R2. |
    <sib reb mi sol>4. ~ <sib reb mi sol>8 r r |
    R2. |
    fa'4( sol8 lab4.) |
    sol8 r r r4. |
    R2. * 2 |
    r32 sol( fad sol lab sol fad sol) fa-. sol( fad sol) mib-. sol( fad sol) re-. sol( fad sol) do,-. sol'( fad sol) |
    sol,8 r <sol' si> <sol si> r <sol si re> |
    <sol si re>2.-\fermata |
    \bar "||"
    \key do \major
    \time 2/2
    <<
      {
	mi4( sol mi sol) |
	fa( la fa la) |
	re, sol re sol |
	mi sol mi r |
      }
      \\
      {
	do2 do |
	do do |
	si si |
	do ~ do4 r |
      }
    >>
    r4
    <<
      {
	do'4( <si re>) r4 |
	r do( <si re>) r |
      }
      \\
      {
	sol2 r4 |
	r sol2 r4 |
      }
      \\
      {
	mi4( fa) r |
	r mi( fa) r |
      }
    >>
    <mi' sol>4( <re fad> <do mi> <si re>) |
    <re, la' do>2( <sol si>4) r |
    R1 * 10 |
    <<
      {
	<re fa>2.( <si re>4) |
	mi r r2 |
	<re fa>2.( <si re>4) |
	mi r r2 |
	<si' re>2( do4) r |
	<sol sib>2( la4) r |
	<mi sol>2( fa4) r |
	R1 |
	R1 |
	<sol do>2 r |
	r4 la sol2 |
	sol r |
	R1 * 2 |
	mi'1 ~
	mi2 re |
	do si |
	la4
      }
      \\
      {
	sol,1 |
	do4 r r2 |
	sol1 |
	do4 r r2 |
	mi2( la4) r |
	do,2( fa4) r |
	la,2( re4) r |
	R1 |
	R1 |
	mi2 r |
	r4 fa( mi re) |
	mi2 r |
	R1 * 2 |
	do'2( si |
	la re, |
	mi1) |
	la4
      }
    >> r4 r2 |
    R1 * 3 |
    <mib sib' reb>2( <mib lab do>4) r |
    <mib sib' reb>2( <mib lab do>4) r |
    <<
      {
	sol2( fad4 sol) |
	la
      }
      \\
      {
	mib1 |
	re4
      }
    >>
    r4 r2 |
    r8 sol( re'4) r8 re,( do'4) |
    r8 sol( si4) r2 |
    r8 fad( re'4) r8 sol,( re'4) |
    r8 re,( re'4) r2 |
    r8 sol,( si4) r8 red,( fad4) |
    r8 mi( sol4) r8 <la, do>-.( <si re>-. <do mi>-.) |
    r8 re( si'4) r8 re,( la'4) |
    sol r r2 |
    \tuplet 3/2 { si,8( re sol) } r4 \tuplet 3/2 { do,8( re fad) } r4 |
    \tuplet 3/2 { si,8 re sol } r4 r2 |
    \tuplet 3/2 { re8 fad la } r4 \tuplet 3/2 { re,8 sol si } r4 |
    \tuplet 3/2 { re,8 fad la } r4 r2 |
    \tuplet 3/2 { sol8 si re } r4 \tuplet 3/2 { red,8 fad la } r4 |
    \tuplet 3/2 { mi8 sol si } r4 \tuplet 3/2 { do,8 mi la } r4 |
    \tuplet 3/2 { re,8 sol si } r4 \tuplet 3/2 { re,8 fad la } r4 |
    <sol si>1( |
    <sol do>) |
    <sol si>( |
    <sol do>) |
    <sol si re> ~ |
    <sol si re>2. r4 |
    R1 * 2 |
    <<
      {
	mi4( sol mi sol) |
	fa( la fa la) |
	re, sol re sol |
	mi sol mi r |
      }
      \\
      {
	do2 do |
	do do |
	si si |
	do2. r4 |
      }
    >>
    r4
    <<
      {
	do'4( <si re>) r4 |
	r do( <si re>) r |
      }
      \\
      {
	sol2 r4 |
	r sol2 r4 |
      }
      \\
      {
	mi4( fa) r |
	r mi( fa) r |
      }
    >>
    <mi' sol>4( <re fad> <do mi> <si re>) |
    <re, la' do>2( <sol si>4) r |
    R1 * 11 |
    <<
      {
	do2( sib |
	la sol)
      }
      \\
      {
	do1 |
	do,
      }
    >>
    fa4 r r2 |
    R1 * 7 |
    r8 fa( la do) r fa,( la do) |
    r mi,( sol do) r mi,( sol do) |
    fa,4 sol la sib |
    do2 do,4 r |
    r8 fa( la do) r fa,( la do) |
    r mi,( sol do) r mi,( sol do) |
    fa,4 re sib <do sol'> |
    <fa sib>2( <fa la>4) r |
    r8 do( mi sol) r re( fa lab) |
    r mi( sol do) r fa,( la do) |
    r reb,( fa lab) r sib,( reb solb) |
    r si,( re lab') <do, sol'>4 r |
    r8 fa( la do) r fa,( la do) |
    r mi,( sol do) r mi,( sol do) |
    fa,4 re sib <do sol'> |
    <fa sib>2( <fa la>4) r4 |
    R1 * 8 |
    <<
      {
	la1 ~ |
	la2 sol |
	fa mi |
	fa4 
      }
      \\
      {
	fa2( mi |
	re sol, |
	la1) |
	re4
      }
    >> r r2 |
    R1 * 3 |
    <lab mib' solb>2( <lab reb fa>4) r |
    <lab mib' solb>2( <la reb fa>4) r |
    <<
      {
	do2 si4 do |
	re r r2 |
	sol4( sib sol sib) |
	lab( sib lab sib) |
	fa( sib fa sib) |
	sol sib sol r |
	r <sol mib'>( <lab re fa>) r |
	r <sol mib'>( <lab re fa>) r |
	sib'( la sol fa) |
	<do mib>2( re4) r
      }
      \\
      {
	lab,1 |
	sol4 r r2 |
	mib'2 mib |
	re re |
	re re |
	mib2. r4 |
	r sib'2 r4 |
	r sib2 r4 |
	sol'( fa mib re) |
	fa,2( sib4) r |
      }
    >>
    R1 * 3 |
    mib1 ~ |
    mib4( re2 mi4) |
    fa1 ~ |
    fa4( mi2 fad4) |
    sol1 |
    R1 * 4 |
    r8 do,,( sol'4) r8 sol,( fa'4) |
    r8 do( mi4) r2 |
    r8 si( sol'4) r8 do,( sol'4) |
    r8 sol,( sol'4) r2 |
    r8 do,( mi4) r8 sold( si4) |
    r8 la( do4) r2 |
    r8 sol,( mi'4) r8 sol,( re'4) |
    do r r2 |
    \tuplet 3/2 { sol8( do mi) } r4 \tuplet 3/2 { sol,8( re' fa) } r4 |
    \tuplet 3/2 { sol,8 do mi } r4 r2 |
    \tuplet 3/2 { sol,8 si re } r4 \tuplet 3/2 { sol,8 do mi } r4 |
    \tuplet 3/2 { sol,8 si re } r4 r2 |
    \tuplet 3/2 { sol8 do mi } r4 \tuplet 3/2 { fa,8 si re } r4 |
    \tuplet 3/2 { mi,8 la do } r4 \tuplet 3/2 { fa,8 la re } r4 |
    \tuplet 3/2 { mi,8 sol do } r4 \tuplet 3/2 { re,8 fa si } r4 |
    <do, mi>1( |
    <do fa>) |
    <do sol' sib>( |
    <do fa la>) |
    \tuplet 3/2 { dod8 mi la } r4 \tuplet 3/2 { re,8 fad la } r4 |
    \tuplet 3/2 { si,8 re sol } r4 \tuplet 3/2 { do,8 mi sol } r4 |
    <re la' do>1 ~ |
    <re la' do> |
    <sol si>2 r |
    R1 * 3 |
    <<
      {
	mi4( sol mi sol) |
	fa( la fa la) |
	re, sol re sol |
	mi sol mi r |
	r <mi do'>( <fa si re>) r |
	r4 <mi do'>( <fa si re>) r |
	sol'( fad mi re) |
	<la do>2( si4) r |
      }
      \\
      {
	do,2 do |
	do do |
	si si |
	do2. r4 |
	r sol'2 r4 |
	r sol2 r4 |
	mi'( re do si) |
	re,2( sol4) r |
      }
    >> |
    R1 * 10 |
    <<
      {
	<re fa>2.( <si re>4) |
	mi4 r r2 |
	<re fa>2.( <si re>4) |
      }
      \\
      {
	sol1 |
	do4 r r2 |
	sol1 |
      }
    >>
    <do mi>4 r r2 |
    <mi si' re>2( <la do>4) r |
    <do, sol' sib>2( <fa la>4) r |
    <la, mi' sol>2( <re fa>4) r |
    R1 * 2 |
    <mi sol do>2 r |
    r4 << { la4 sol2 | sol } \\ { fa4( mi re) | mi2} >> r |
    R1 * 4 |
    <si' re fa>1 |
    <do mi>2. r4 |
    R1 * 2 |
    << { <si re>2.( si4) } \\ { <fa sol>1 } >> |
    <mi sol>4 r r2 |
    r8 do'( mi4) r8 sold,( si4) |
    r8 la( do4) r2 |
    R1 * 2 |
    r8 si( do4) r8 fad,( sol4) |
    r8 sold( la4) r2 |
    R1 |
    <<
      {
	mi8 sol mi sol re sol re sol |
	mi sol mi sol fa sol fa sol |
	mi sol mi sol re sol re sol |
	mi sol mi sol fa sol fa sol
      }
      \\
      {
	do,1 |
	do |
	do |
	do
      }
    >> |
    <do mi>4 r <do mi sol> r |
    <do mi sol>2 r |
    \bar "|."
}